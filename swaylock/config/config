# swaylock config — omarchy colour palette
# bg #0d0d0d  accent #33ccff (cyan)  green #00ff99  fg #ffffff

daemonize
show-failed-attempts
ignore-empty-password

# Colours (no leading #)
color=0d0d0d
inside-color=0d0d0d
inside-clear-color=0d0d0d
inside-caps-lock-color=141414
inside-ver-color=0d0d0d
inside-wrong-color=0d0d0d

ring-color=595959
ring-clear-color=33ccff
ring-caps-lock-color=ffaa00
ring-ver-color=33ccff
ring-wrong-color=ff5555

key-hl-color=00ff99
caps-lock-key-hl-color=ffaa00
bs-hl-color=ff5555
caps-lock-bs-hl-color=ff5555

text-color=ffffff
text-clear-color=33ccff
text-caps-lock-color=ffaa00
text-ver-color=33ccff
text-wrong-color=ff5555

line-uses-ring
separator-color=00000000

# Layout
indicator-radius=80
indicator-thickness=6
