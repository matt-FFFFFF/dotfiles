#!/usr/bin/env python3
"""macos-set-wallpaper — set desktop wallpaper across all Spaces on all displays.

macOS 26 (Tahoe) rewrote ~/Library/Application Support/com.apple.wallpaper's
Store/Index.plist. The pre-Tahoe layout stored a `Configuration` bplist with
`type == "imageFile"` and `url.relative` per Space; Tahoe replaced it with a
per-choice `Provider` + `Configuration` blob and split sections into either
`Type: linked` (a single wallpaper shared across all Spaces and displays,
stored under a `Linked` key) or `Type: individual` (per-Space/per-display
`Desktop`/`Idle` entries).

Apple's public APIs only touch the visible Space, so to cover every Space we
write a `linked` wallpaper into the top-level `AllSpacesAndDisplays` and
`SystemDefault` sections and drop any per-Space/per-display overrides, then
signal WallpaperAgent to reload.

Usage: macos-set-wallpaper <path-to-image>

Safe no-op on non-Darwin and when Index.plist does not exist yet.
"""

import datetime
import os
import plistlib
import subprocess
import sys
import urllib.parse

INDEX_PLIST = os.path.expanduser(
    "~/Library/Application Support/com.apple.wallpaper/Store/Index.plist"
)

IMAGE_PROVIDER = "com.apple.wallpaper.choice.image"


def make_image_choice(new_url: str) -> dict:
    inner = {"type": "imageFile", "url": {"relative": new_url}}
    return {
        "Provider": IMAGE_PROVIDER,
        "Files": [],
        "Configuration": plistlib.dumps(inner, fmt=plistlib.FMT_BINARY),
    }


def set_linked(section: dict, choice: dict, now: datetime.datetime) -> None:
    section.clear()
    section["Type"] = "linked"
    section["Linked"] = {
        "Content": {
            "Choices": [choice],
            "Shuffle": "$null",
            "EncodedOptionValues": "$null",
        },
        "LastSet": now,
        "LastUse": now,
    }


def replace_wallpaper(index_path: str, new_url: str) -> int:
    with open(index_path, "rb") as f:
        data = plistlib.load(f)

    choice = make_image_choice(new_url)
    now = datetime.datetime.now()
    count = 0

    for key in ("AllSpacesAndDisplays", "SystemDefault"):
        set_linked(data.setdefault(key, {}), choice, now)
        count += 1

    data["Spaces"] = {}
    data["Displays"] = {}

    with open(index_path, "wb") as f:
        plistlib.dump(data, f, fmt=plistlib.FMT_BINARY)
    return count


def main() -> int:
    if sys.platform != "darwin":
        return 0
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} <path-to-image>", file=sys.stderr)
        return 2

    path = os.path.abspath(sys.argv[1])
    if not os.path.isfile(path):
        print(f"error: not a file: {path}", file=sys.stderr)
        return 1
    if not os.path.isfile(INDEX_PLIST):
        return 0

    new_url = "file://" + urllib.parse.quote(path, safe="/")
    n = replace_wallpaper(INDEX_PLIST, new_url)
    subprocess.run(["killall", "WallpaperAgent"], stderr=subprocess.DEVNULL)
    print(f"updated {n} wallpaper sections (all Spaces and displays)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
