#!/usr/bin/env bash
# wallpaper-cycle-daemon — Linux respawn wrapper preserving the original
# `sway exec_always` behaviour. Calls the one-shot wallpaper-cycle once per
# hour. On macOS, scheduling is handled by launchd — this wrapper is unused.

set -u
DOTFILES="${DOTFILES_ROOT:-$HOME/.dotfiles}"

while true; do
  "$DOTFILES/bin/wallpaper-cycle" || true
  sleep 3600
done
