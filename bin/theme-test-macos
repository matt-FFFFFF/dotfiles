#!/usr/bin/env bash
# Smoke test for macOS theme engine — exits 0 on success, 1 on any failure. Run after theme-set changes.

[[ "$(uname)" != "Darwin" ]] && { echo "skipped on non-Darwin"; exit 0; }

set -u

ORIG=$(theme-current)
trap '"$HOME/.dotfiles/bin/theme-set" "$ORIG" >/dev/null 2>&1 || true' EXIT

fails=0

pass() {
  printf 'PASS: %s\n' "$1"
}

fail() {
  printf 'FAIL: %s (expected %s, got %s)\n' "$1" "$2" "$3"
  fails=$((fails + 1))
}

assert_eq() {
  desc=$1
  expected=$2
  actual=$3
  if [[ "$actual" == "$expected" ]]; then
    pass "$desc"
  else
    fail "$desc" "$expected" "$actual"
  fi
}

assert_regex() {
  desc=$1
  expected=$2
  actual=$3
  if grep -Eq "$expected" <<<"$actual"; then
    pass "$desc"
  else
    fail "$desc" "/$expected/" "$actual"
  fi
}

assert_contains() {
  desc=$1
  expected=$2
  actual=$3
  if grep -Fq "$expected" <<<"$actual"; then
    pass "$desc"
  else
    fail "$desc" "$expected" "$actual"
  fi
}

assert_cmd() {
  desc=$1
  shift
  if "$@" >/dev/null 2>&1; then
    pass "$desc"
  else
    fail "$desc" 0 $?
  fi
}

assert_cmd "theme-set tokyo-night" theme-set tokyo-night
assert_eq "defaults read -g AppleInterfaceStyle" "Dark" "$(defaults read -g AppleInterfaceStyle 2>&1)"
assert_eq "defaults read -g AppleInterfaceStyleSwitchesAutomatically" "0" "$(defaults read -g AppleInterfaceStyleSwitchesAutomatically 2>&1)"
assert_eq "defaults read -g AppleAccentColor" "4" "$(defaults read -g AppleAccentColor 2>&1)"
assert_regex "defaults read -g AppleHighlightColor" '0\.4[0-9]+ 0\.6[0-9]+ 0\.9[0-9]+ Other' "$(defaults read -g AppleHighlightColor 2>&1)"

# Wallpaper assertion — query Index.plist directly to verify every Configuration
# blob (one per Space + per-display cache + SystemDefault) points to the same
# image. `wallpaper get` only reports visible Spaces and would miss the bug.
WALLPAPER_URLS=$(python3 -c '
import plistlib, os
p = os.path.expanduser("~/Library/Application Support/com.apple.wallpaper/Store/Index.plist")
with open(p, "rb") as f: d = plistlib.load(f)
urls = set()
def walk(n):
    if isinstance(n, dict):
        for k, v in n.items():
            if k == "Configuration" and isinstance(v, bytes) and v[:8] == b"bplist00":
                try:
                    inner = plistlib.loads(v)
                    if isinstance(inner, dict) and inner.get("type") == "imageFile":
                        urls.add(inner.get("url", {}).get("relative", ""))
                except: pass
            else: walk(v)
    elif isinstance(n, list):
        for i in n: walk(i)
walk(d)
for u in sorted(urls): print(u)' 2>/dev/null)

if echo "$WALLPAPER_URLS" | grep -q tokyo-night; then
  pass "wallpaper URLs contain 'tokyo-night'"
else
  fail "wallpaper" "URL containing tokyo-night" "$WALLPAPER_URLS"
fi

UNIQUE_COUNT=$(echo "$WALLPAPER_URLS" | grep -c .)
if [ "$UNIQUE_COUNT" = "1" ]; then
  pass "all Index.plist Configuration blobs point to the same wallpaper (multi-Space coverage)"
else
  fail "multi-Space" "1 unique URL across all Spaces" "$UNIQUE_COUNT unique URLs"
fi

assert_cmd "theme-set catppuccin-latte" theme-set catppuccin-latte
assert_regex "defaults read -g AppleInterfaceStyle deleted" 'does not exist' "$(defaults read -g AppleInterfaceStyle 2>&1)"
assert_cmd "theme-set tokyo-night idempotency" theme-set tokyo-night

exit "$fails"
